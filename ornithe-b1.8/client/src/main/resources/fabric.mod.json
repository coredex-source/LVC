  ],
  "depends": {
    "fabricloader": ">=0.20.1",
    "minecraft": "1.0.0-beta.8.0.r",
    "osl-entrypoints": ">=0.6.0",
    "osl-networking": ">=0.12.0"
  },
  "environment": "client"
