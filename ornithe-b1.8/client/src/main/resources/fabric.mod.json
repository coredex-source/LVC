{
  "schemaVersion": 1,
  "id": "legacyvoicechat",
  "version": "${version}",
  "name": "LegacyVoiceChat",
  "description": "Cross-loader voice chat for Minecraft.",
  "authors": [
    "Moyettes"
  ],
  "contact": {
    "homepage": "https://github.com/moyettes/legacyvoicechat",
